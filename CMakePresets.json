{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "KIKA_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "win-debug",
      "displayName": "Windows x64 — Debug",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win-release",
      "displayName": "Windows x64 — Release",
      "inherits": "windows-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-gui-base",
      "hidden": true,
      "inherits": "windows-base",
      "description": "С окном kika-gui. Qt подключается библиотеками DLL, поэтому среда выполнения C++ тоже DLL (/MD). Папка Qt — в переменной окружения QT_ROOT_DIR.",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL",
        "KIKA_BUILD_GUI": "ON",
        "KIKA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "win-gui-debug",
      "displayName": "Windows x64 с окном (Qt) — Debug",
      "inherits": "windows-gui-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win-gui-release",
      "displayName": "Windows x64 с окном (Qt) — Release",
      "inherits": "windows-gui-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux — Debug",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux — Release",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ci-windows",
      "displayName": "CI: Windows x64 Release, предупреждения = ошибки",
      "inherits": "win-release",
      "cacheVariables": { "KIKA_WERROR": "ON" }
    },
    {
      "name": "ci-windows-gui",
      "displayName": "CI: Windows x64 с окном, Release, предупреждения = ошибки",
      "inherits": "win-gui-release",
      "cacheVariables": { "KIKA_WERROR": "ON" }
    },
    {
      "name": "ci-linux",
      "displayName": "CI: Linux Release с окном, предупреждения = ошибки",
      "inherits": "linux-release",
      "cacheVariables": { "KIKA_WERROR": "ON", "KIKA_BUILD_GUI": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "win-debug", "configurePreset": "win-debug" },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "win-gui-debug", "configurePreset": "win-gui-debug" },
    { "name": "win-gui-release", "configurePreset": "win-gui-release" },
    { "name": "ci-windows", "configurePreset": "ci-windows" },
    { "name": "ci-windows-gui", "configurePreset": "ci-windows-gui" },
    { "name": "ci-linux", "configurePreset": "ci-linux" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "win-debug", "inherits": "test-base", "configurePreset": "win-debug" },
    { "name": "win-release", "inherits": "test-base", "configurePreset": "win-release" },
    { "name": "linux-debug", "inherits": "test-base", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "test-base", "configurePreset": "linux-release" },
    { "name": "ci-windows", "inherits": "test-base", "configurePreset": "ci-windows" },
    { "name": "ci-linux", "inherits": "test-base", "configurePreset": "ci-linux" }
  ]
}

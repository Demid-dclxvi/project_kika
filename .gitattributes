* text=auto
# G-code — эталонные данные тестов: байты не меняем, большие диффы не показываем
*.gcode -text -diff
*.min.js -diff
# модели — двоичные
*.3mf binary
*.stl binary
*.bat text eol=crlf
*.sh text eol=lf

# сторонний просмотрщик: не сравнивать построчно
src/report/web/vendor/** -text -diff linguist-vendored

# Файлы для пользователей Windows — с переводами строк Windows
*.cmd text eol=crlf
packaging/windows/*.txt text eol=crlf
